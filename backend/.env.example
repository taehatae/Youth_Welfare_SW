APP_NAME=Youth Welfare Reverse Engineering API
APP_VERSION=0.1.0

DATABASE_URL=sqlite:///./youth_welfare.db

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 로컬 HTTP 개발은 false, HTTPS 배포에서는 true
COOKIE_SECURE=false

WELFARE_API_SERVICE_KEY=
WELFARE_API_BASE_URL=

# 실험 기능: 진단할 때 로컬 Ollama(Gemma)가 정책 원문과 사용자 입력을 직접 비교
USE_LLM_JUDGE=false
LLM_MODEL=gemma3:4b-it-q8_0
OLLAMA_URL=http://localhost:11434
LLM_CONCURRENCY=4

# 검수를 마친 구조화 조건(data/structured_conditions.json)으로 입력값과 정책 자격을 비교
USE_STRUCTURED_CONDITIONS=false
