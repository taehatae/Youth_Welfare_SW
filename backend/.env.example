APP_NAME=Youth Welfare Reverse Engineering API
APP_VERSION=0.1.0

DATABASE_URL=sqlite:///./youth_welfare.db

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 로컬 HTTP 개발은 false, HTTPS 배포에서는 true
COOKIE_SECURE=false

WELFARE_API_SERVICE_KEY=
WELFARE_API_BASE_URL=

# 실험 기능: 진단할 때 로컬 Ollama(Gemma)가 정책 원문과 사용자 입력을 직접 비교
USE_LLM_JUDGE=false
LLM_MODEL=gemma3:4b-it-q8_0
OLLAMA_URL=http://localhost:11434
LLM_CONCURRENCY=4

# 검수를 마친 구조화 조건(data/structured_conditions.json)으로 입력값과 정책 자격을 비교
# 자격 경로·역설계 실행 환경을 재현할 때 true로 명시한다. 실제 .env는 덮어쓰지 않는다.
USE_STRUCTURED_CONDITIONS=false

# 자격 경로·역설계는 true로 명시한다. 구조화 조건보다 우선하며 USE_LLM_JUDGE는 false로 둔다.
# 먼저 원문을 가져온 뒤 scripts.load_eligibility_paths로 명시적 적재: docs/eligibility-paths/LOCAL_SETUP.md 참고.
# 경로가 0건이면 진단 시 자동 적재/커밋되므로 기존 DB 백업 없이 처음 진단부터 실행하지 않는다.
# 시드의 status=reviewed 152개 중 사람 검수는 drafted_by != converted인 60개다.
USE_ELIGIBILITY_PATHS=false
